{
    "name": "cramblda/functionalchaos.net",
    "description": "Source for the functionalchaos.net blog, built with Sculpin",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "David Cramblett"
        }
    ],
    "require": {
        "php": "^8.5",
        "sculpin/sculpin": "^4.0@alpha",
        "beryllium/icelus": "^4.0@alpha"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "sculpin-watch": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/sculpin generate --watch --server --port=8008"
        ]
    },
    "config": {
        "allow-plugins": {
            "sculpin/sculpin-theme-composer-plugin": true
        }
    }
}
